# Copie para .env para usar um LLM de verdade em local.
# As chaves NUNCA vão para o repositório: na AWS elas vêm do Parameter Store.
LLM_PROVIDER=mock        # mock | bedrock | gemini | groq
# Só para rodar o Bedrock em local: o compose usa credenciais AWS falsas para o
# DynamoDB Local. Na AWS a autenticação é a task role, e esta variável fica vazia.
AWS_BEARER_TOKEN_BEDROCK=
GEMINI_API_KEY=
GROQ_API_KEY=
